{
  "name": "project-management",
  "version": "1.0.0",
  "private": true,
  "description": "Receive GitHub pull request webhooks and optionally relay them to another server.",
  "scripts": {
    "start": "node dist/backend/server.js",
    "dev": "tsx watch backend/src/server.ts",
    "test": "vitest run",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "lint": "eslint backend/src/**/*.{ts,tsx} frontend/src/**/*.{ts,tsx} --max-warnings=0",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p frontend/tsconfig.json",
    "test:unit": "vitest run",
    "test:realtime": "node scripts/realtime-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "nodemailer": "^6.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^6.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
