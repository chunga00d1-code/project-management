{
  "name": "pr-review-task-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Receives GitHub pull request webhooks, runs automated review checks, and tracks review tasks in a web dashboard.",
  "scripts": {
    "start": "node dist/backend/server.js",
    "dev": "tsx watch backend/src/server.ts",
    "test": "vitest run",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "lint": "eslint backend/src/**/*.{ts,tsx} frontend/src/**/*.{ts,tsx} --max-warnings=0",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p frontend/tsconfig.json",
    "test:unit": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
